---
import ProtocolLayout from '@/layouts/protocol.astro'
import { getCollection, render } from 'astro:content'

const all = await getCollection(
  'protocols',
  ({ data }) => !data.version_outdated,
)
const protocol = all[0]
const { data } = protocol
const { Content } = await render(protocol)
---

<ProtocolLayout
  title={data.title}
  description={data.description}
  selectedVersion={data.version}
  currentVersion={data.version}
>
  <Content />
</ProtocolLayout>
